{
  // Preset: LierB/fastfetch "full-info" (github.com/LierB/fastfetch) — every module.
  // Previous theme kept as hyprflux.jsonc (switch back by swapping the two files).
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/2.68.1/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.png",
    "type": "kitty",
    "height": 18,
    "width": 38,
    "padding": {
      "top": 1
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "bios",
    "board",
    "chassis",
    "kernel",
    "uptime",
    "processes",
    "packages",
    "shell",
    "display",
    "brightness",
    "monitor",
    "lm",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "wallpaper",
    "terminal",
    "terminalfont",
    "terminalsize",
    "terminaltheme",
    "cpu",
    "cpuusage",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "player",
    "media",
    "publicip",
    "localip",
    "wifi",
    "datetime",
    "locale",
    "vulkan",
    "opengl",
    "opencl",
    "users",
    "bluetooth",
    "sound",
    "gamepad",
    "weather",
    "netio",
    "diskio",
    "physicaldisk",
    "version",
    "break",
    "colors"
  ]
}

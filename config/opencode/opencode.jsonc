{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "default_agent": "build",
  "agents": {
    "build": { "mode": "all" },
    "explore": { "model": "opencode-go/space-bunny-free", "steps": 12 }
  },
  "lsp": true,
  "compaction": { "auto": true, "buffer": 10000 },
  "experimental": { "subagent_depth": 3 },
  // Headroom proxy removed 2026-09-23 — the three providers below no longer
  // override baseURL; they use their catalog endpoints (zen/go, zen, openrouter)
  // directly. Only the custom reasoning-effort variants remain.
  "providers": {
    "opencode-go": {
      "models": {
        "mimo-v2.6-flash": {
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } }
          ]
        }
      }
    }
  },
  "mcp": {
    // browser-use MCP (2026-09-24) — official stdio server for LLM-driven
    // autonomous browser tasks. Version pin now lives in the `browser-use-mcp`
    // wrapper (home/modules/opencode). The key is read from
    // ~/.config/browser-use/key (0600), written from .env.toml by the
    // home/modules/env activation — no env indirection, so an empty
    // OPENCODE_BROWSER_USE_API_KEY in the daemonized service env can no longer
    // poison it. Model mimo-v2.6-flash — cheapest Go model that passes strict
    // json_schema (deepseek-v4.1-flash fails structured output). Base URL goes
    // through the localhost browser-use-llm-proxy (systemd user service, see
    // home/modules/opencode) which adds the Go-required x-opencode-session
    // header; the key still comes from ~/.config/browser-use/key via the
    // browser-use-mcp wrapper. Browser + filesystem access — agent-browser
    // stays default.
    "browser-use": {
      "type": "local",
      "command": ["browser-use-mcp"],
      "enabled": true,
      "environment": {
        "OPENAI_BASE_URL": "http://127.0.0.1:49381/v1",
        "BROWSER_USE_LLM_MODEL": "mimo-v2.6-flash"
      }
    },
    "codegraph": { "type": "local", "command": ["codegraph", "serve", "--mcp"], "enabled": true, "environment": { "CODEGRAPH_TELEMETRY": "0", "CODEGRAPH_DAEMON_IDLE_TIMEOUT_MS": "1800000" } },
    // icm is no longer an MCP server (2026-09-24): its tools are registered by
    // config/opencode/plugins/icm.ts under the `icm` namespace, backed by the
    // `icm-http` systemd user service (home/modules/opencode/default.nix) and
    // the `icm` CLI. Same exposed tool names (`icm_memory_*`, `icm_wake_up`, ...).
    // jev-mcp — TypeSafe Jev typed decision layer (diff review gate, change risk,
    // requirement check, coding-loop routing). Binary: `jev-mcp` (bun global,
    // home/modules/upstream). The key comes from ~/.config/typesafe/key (0600),
    // written from .env.toml by the home/modules/env activation — no env
    // indirection, so an empty TYPESAFE_API_KEY in the daemonized service env
    // can no longer poison it. Without the file, tools return an auth error.
    "jev-mcp": {
      "type": "local",
      "command": ["jev-mcp"],
      "enabled": true
    }
  },
  "shell": "/usr/bin/zsh"
}

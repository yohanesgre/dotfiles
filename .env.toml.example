# .env.toml.example — copy to .env.toml and fill (never commit .env.toml)
# Usage:
#   cp .env.toml.example .env.toml
#   $EDITOR .env.toml       # fill real values
#   home-manager switch     # or: source via extra.zsh auto-loads on new shell
#
# Sourced automatically by config/zsh/extra.zsh from:
#   1) ~/projects/dotfiles/.env.toml (canonical)
#   2) ~/.env.toml                 (fallback, global)
# Systemd user env imported via home/modules/env activation.
#
# Format: flat TOML keys (top-level). Sections optional — if used,
# keys are flattened as SECTION_KEY (e.g. [discord] channel_id -> DISCORD_CHANNEL_ID).
# Values must be quoted strings. Use # for comments.

# ── Discord (hermes gateway) ─────────────────────────────────────
# Replace placeholders in config/hermes/profiles/*/config.yaml:
#   home_channel / chat_id = your Discord channel IDs
DISCORD_CHANNEL_ID = "REPLACE_WITH_YOUR_DISCORD_CHANNEL_ID"
DISCORD_CHANNEL_ID_2 = "REPLACE_WITH_YOUR_DISCORD_CHANNEL_ID_2"
DISCORD_CHANNEL_ID_3 = "REPLACE_WITH_YOUR_DISCORD_CHANNEL_ID_3"
DISCORD_BOT_TOKEN = ""
OWNER_DISCORD_USER_ID = "REPLACE_WITH_OWNER_DISCORD_USER_ID"

# ── LLM providers ────────────────────────────────────────────────
# Hermes profiles default to deepseek; override via .env.toml if using OpenAI-compat
OPENAI_API_KEY = "sk-..."
ANTHROPIC_API_KEY = "sk-ant-..."
DEEPSEEK_API_KEY = "sk-..."

# Hermes generic (used by install-hermes.sh / hermes gateway)
HERMES_PROVIDER = "openai"
HERMES_MODEL = "gpt-4o"
HERMES_BASE_URL = ""

# opencode-go
OPENCODE_API_KEY = ""

# ── Optional ─────────────────────────────────────────────────────
GEMINI_API_KEY = ""
GOOGLE_API_KEY = ""
CLOUDFLARE_API_KEY = ""

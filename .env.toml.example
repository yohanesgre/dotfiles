# .env.toml.example — copy to .env.toml and fill (never commit .env.toml)
# Usage:
#   cp .env.toml.example .env.toml
#   $EDITOR .env.toml       # fill real values
#   home-manager switch     # or: source via extra.zsh auto-loads on new shell
#
# Sourced automatically by config/zsh/extra.zsh from:
#   1) ~/projects/dotfiles/.env.toml (canonical)
#   2) ~/.env.toml                 (fallback, global)
# Systemd user env imported via home/modules/env activation.
#
# Format: flat TOML keys (top-level). Sections optional — if used,
# keys are flattened as SECTION_KEY (e.g. [discord] channel_id -> DISCORD_CHANNEL_ID).
# Values must be quoted strings. Use # for comments.

# ── Discord (hermes gateway) ─────────────────────────────────────
# Each bot suite (n): 1 token + N channels + M owners (all comma-separated).
#   DISCORD_CHANNEL_ID_n = "x1,x2,x3"        → channels owned by bot n
#   OWNER_DISCORD_USER_ID_n = "u1,u2,u3"    → pairing allowlist for bot n
#   owned by DISCORD_BOT_TOKEN_n + OWNER_DISCORD_USER_ID_n
#   home_channel(s) in config/hermes/profiles/*/config.yaml must match CHANNEL_ID_n
#   profile_routes in primary profile multiplexes channels via one bot when _3 empty.
#
# bot 1 — primary (also multiplexes bot 3 channels when BOT_3 empty)
DISCORD_CHANNEL_ID = "REPLACE_WITH_YOUR_DISCORD_CHANNEL_ID"       # x1[,x2,x3] e.g. "111111111111111111" or "111111111111111111,222222222222222222"
DISCORD_BOT_TOKEN = ""                                            # bot 1 token
OWNER_DISCORD_USER_ID = "REPLACE_WITH_OWNER_DISCORD_USER_ID"      # u1[,u2,u3] e.g. "999999999999999999" or "999...,888..."
HERMES_PROFILE = ""                                               # optional hermes profile for bot 1 (default: primary profile)
#
# bot 2 — dedicated gateway (e.g. hermes-gateway-profile2.service)
DISCORD_CHANNEL_ID_2 = "REPLACE_WITH_YOUR_DISCORD_CHANNEL_ID_2"   # x1[,x2,x3] e.g. "333333333333333333"
DISCORD_BOT_TOKEN_2 = ""                                          # bot 2 token
OWNER_DISCORD_USER_ID_2 = "REPLACE_WITH_OWNER_DISCORD_USER_ID_2"  # u1[,u2,u3] fallback to OWNER_DISCORD_USER_ID if empty
HERMES_PROFILE_2 = ""                                             # optional hermes profile for bot 2 (default: profile2)
#
# bot 3 — optional dedicated (omit token to keep multiplex via bot 1)
DISCORD_CHANNEL_ID_3 = "REPLACE_WITH_YOUR_DISCORD_CHANNEL_ID_3"   # x1[,x2,x3] e.g. "444444444444444444"
DISCORD_BOT_TOKEN_3 = ""                                          # bot 3 token — if empty, bot 1 multiplexes CHANNEL_ID_3
OWNER_DISCORD_USER_ID_3 = "REPLACE_WITH_OWNER_DISCORD_USER_ID_3"  # u1[,u2,u3] fallback to OWNER_DISCORD_USER_ID
HERMES_PROFILE_3 = ""                                             # optional hermes profile for bot 3 (default: profile3)

# ── LLM providers ────────────────────────────────────────────────
DEEPSEEK_API_KEY = "sk-..."

# Hermes generic (used by install-hermes.sh / hermes gateway)
HERMES_PROVIDER = "deepseek"
HERMES_MODEL = "deepseek-v4-flash"
HERMES_BASE_URL = "https://api.deepseek.com/v1"

# opencode-go
OPENCODE_API_KEY = ""
